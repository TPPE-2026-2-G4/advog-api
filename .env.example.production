# ==============================================================================
# CONFIGURAÇÃO DE PRODUÇÃO - ADVOG API (RENDER + NEON + S3/R2)
# ==============================================================================

# AMBIENTE:
# Define a operação em modo de produção.
# Em produção, a API exige DATABASE_URL válida (sem fallback SQLite) e SECRET_KEY definida.
ENVIRONMENT=production

# PORTA DA APLICAÇÃO:
# No Render, a variável $PORT é injetada dinamicamente pelo ambiente.
# Localmente ou em fallback, usa a porta 8000.
PORT=8000

# BANCO DE DADOS (POSTGRESQL NEON):
# String de conexão do PostgreSQL Neon com pooler habilitado e sslmode=require.
# Exemplo: postgresql://<user>:<password>@ep-cool-fog-123456-pooler.us-east-2.aws.neon.tech/<dbname>?sslmode=require
# A API configura automaticamente pool_pre_ping=True, pool_recycle=300 e pool_timeout=30 para reconectar
# graciosamente após a suspensão por inatividade (scale-to-zero) do Neon.
DATABASE_URL=postgresql://usuario:senha@ep-xyz-pooler.us-east-2.aws.neon.tech/advog_prod?sslmode=require

# SEGURANÇA E AUTENTICAÇÃO (JWT):
# Chave secreta de alta entropia para assinatura dos tokens JWT.
# OBRIGATÓRIA em produção: a inicialização aborta imediatamente se ausente ou com valor padrão de desenvolvimento.
# Gere uma chave segura com: openssl rand -hex 32
SECRET_KEY=substitua_por_uma_chave_secreta_longa_e_aleatoria_com_mais_de_32_caracteres
JWT_SECRET=

# URLs E COMUNICAÇÃO COM O FRONTEND:
# FRONTEND_URL: Usado exclusivamente para compor links enviados por e-mail (ex: ativação de conta / primeiro acesso).
FRONTEND_URL=https://advog-web.onrender.com

# CORS_ORIGINS: Lista de origens autorizadas para preflight e requisições cross-origin (separadas por vírgula).
# Desacoplada de FRONTEND_URL para permitir múltiplos domínios ou portas de acesso.
CORS_ORIGINS=https://advog-web.onrender.com,https://painel.escritorio.adv.br

# SERVIÇO DE E-MAIL (SMTP - SENDGRID, RESEND, BREVO, AWS SES):
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=re_123456789
SMTP_FROM=nao-responda@escritorio.adv.br

# ARMAZENAMENTO DE ARQUIVOS (AWS S3 / CLOUDFLARE R2):
# Configure o endpoint S3 compatível com SSL habilitado.
# Para Cloudflare R2: https://<account_id>.r2.cloudflarestorage.com
# Para AWS S3: https://s3.<region>.amazonaws.com
MINIO_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
MINIO_PUBLIC_URL=https://pub-<hash>.r2.dev
MINIO_BUCKET=advog-producao
MINIO_USE_SSL=true
MINIO_ROOT_USER=seu_access_key_id
MINIO_ROOT_PASSWORD=seu_secret_access_key

# INTEGRAÇÃO DATAJUD (CNJ):
DATAJUD_API_KEY=cDZHYzlZa0JadVREZDJCendQbXY6SkJlTzNjLV9TRENyQk1RdnFKZGRQdw==
DATAJUD_BASE_URL=https://api-publica.datajud.cnj.jus.br
DATAJUD_MOCK=false

# DADOS DO ADMINISTRADOR INICIAL (SEED):
ADMIN_EMAIL=admin@escritorio.adv.br
ADMIN_PASSWORD=SenhaForteAdmin@2026

# ENDPOINTS DE MONITORAMENTO DISPONÍVEIS:
# - /health: Liveness probe estático (<50ms, HTTP 200, sem query ao banco, ideal para UptimeRobot)
# - /health/ready: Readiness probe (valida conexão ativa com o PostgreSQL Neon e Storage com timeout de 3s)

